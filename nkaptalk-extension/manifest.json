{
  "manifest_version": 3,
  "name": "NkapTalk — Pidgin banking assistant",
  "short_name": "NkapTalk",
  "version": "0.2.0",
  "description": "Use your bank in Pidgin by voice, with the page in Pidgin or a Cameroonian language. Amounts, names and references never change.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NkapTalk (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://safinum.cm/hackathon-test*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "content/values.js",
        "content/phrasebook.js",
        "content/localize.js",
        "content/env.js",
        "content/localbook.js",
        "content/translator.js",
        "content/numerals.js",
        "content/clipvoice.js",
        "content/speech.js",
        "content/nlu.js",
        "content/screen.js",
        "content/replybook.js",
        "content/assistant.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "audio/*/*",
        "lexicon/*",
        "lexicon/replies/*"
      ],
      "matches": [
        "https://safinum.cm/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
